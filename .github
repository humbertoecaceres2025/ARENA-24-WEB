name: ARENA 24 - Actualizar noticias

on:
  schedule:
    # Ejecutar cada 30 minutos
    - cron: "*/30 * * * *"

  # Permite ejecutarlo manualmente desde GitHub
  workflow_dispatch:

  # También se ejecuta cuando modificás este archivo
  push:
    paths:
      - ".github/workflows/actualizar-noticias.yml"

permissions:
  contents: write

jobs:

  actualizar:

    runs-on: ubuntu-latest

    steps:

      # =====================================================
      # 1. Descargar el repositorio
      # =====================================================

      - name: Descargar repositorio
        uses: actions/checkout@v4


      # =====================================================
      # 2. Preparar Python
      # =====================================================

      - name: Preparar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"


      # =====================================================
      # 3. Instalar dependencias
      # =====================================================

      - name: Instalar dependencias
        run: |
          python -m pip install --upgrade pip
          pip install requests feedparser


      # =====================================================
      # 4. Ejecutar actualizador
      # =====================================================

      - name: Actualizar noticias
        run: |
          python actualizar_noticias.py


      # =====================================================
      # 5. Guardar noticias.json
      # =====================================================

      - name: Guardar cambios
        run: |

          git config user.name "ARENA 24 Bot"

          git config user.email "actions@github.com"

          git add noticias.json

          if git diff --cached --quiet; then
            echo "No hay cambios en las noticias."
          else
            git commit -m "ARENA 24 - actualización automática"
            git push
          fi
