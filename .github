name: ARENA 24 - Actualizar información

on:

  schedule:
    - cron: "*/30 * * * *"

  workflow_dispatch:

permissions:
  contents: write

jobs:

  actualizar:

    runs-on: ubuntu-latest

    steps:

      - name: Descargar repositorio
        uses: actions/checkout@v4


      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"


      - name: Instalar dependencias
        run: |
          python -m pip install --upgrade pip
          pip install requests feedparser


      - name: Actualizar noticias, dólar y clima
        run: |
          python actualizar_noticias.py


      - name: Guardar noticias.json
        run: |

          git config user.name "ARENA 24 Bot"

          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add noticias.json

          if git diff --cached --quiet; then

            echo "No hay cambios para guardar."

          else

            git commit -m "Actualización automática ARENA 24"

            git push

          fi
