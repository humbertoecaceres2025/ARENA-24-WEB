.github/workflows
actualizar-noticias.yml
name: ARENA 24 - Actualizar noticias

on:

  workflow_dispatch:

  schedule:

    - cron: "*/30 * * * *"


permissions:

  contents: write


jobs:

  actualizar:

    runs-on: ubuntu-latest

    steps:

      - name: Descargar repositorio
        uses: actions/checkout@v4


      - name: Configurar Node
        uses: actions/setup-node@v4
        with:
          node-version: 20


      - name: Crear actualizador
        shell: bash
        run: |

          cat > actualizar.js <<'EOF'

          const fs = require("fs");

          const NEWS_SOURCES = [

            {
              name: "Nueva Rioja",
              url: "https://nuevarioja.com.ar/"
            },

            {
              name: "Gobierno de La Rioja",
              url: "https://actualidad.larioja.org/"
            }

          ];


          async function fetchText(url) {

            const response =
              await fetch(url, {
                headers: {
                  "User-Agent":
                    "ARENA24-NewsBot/1.0"
                }
              });

            if (!response.ok) {

              throw new Error(
                `HTTP ${response.status}`
              );

            }

            return await response.text();

          }


          function stripHTML(text) {

            return text
              .replace(/<[^>]*>/g, " ")
              .replace(/\s+/g, " ")
              .trim();

          }


          function decodeHTML(text) {

            return text
              .replace(/&amp;/g, "&")
              .replace(/&quot;/g, '"')
              .replace(/&#39;/g, "'")
              .replace(/&lt;/g, "<")
              .replace(/&gt;/g, ">");
          }


          function extractTitles(html) {

            const results = [];

            const regex =
              /<(?:h1|h2|h3|h4)[^>]*>([\s\S]*?)<\/(?:h1|h2|h3|h4)>/gi;

            let match;

            while (
              (match = regex.exec(html)) !== null
            ) {

              const title =
                decodeHTML(
                  stripHTML(match[1])
                );

              if (
                title.length > 20 &&
                title.length < 220
              ) {

                results.push(title);

              }

            }

            return [
              ...new Set(results)
            ];

          }


          function classify(title) {

            const t =
              title.toLowerCase();


            if (
              /polic|deten|accidente|robo|asalto|justicia|fiscal|homicid|violencia|allanamiento/.test(t)
            ) {

              return "Policiales";

            }


            if (
              /fútbol|futbol|deporte|basquet|básquet|tenis|mundial|river|boca|mess|liga|gol/.test(t)
            ) {

              return "Deportes";

            }


            return "La Rioja";

          }


          async function getNews() {

            const all = [];


            for (
              const source
              of NEWS_SOURCES
            ) {

              try {

                const html =
                  await fetchText(
                    source.url
                  );

                const titles =
                  extractTitles(html);


                titles
                  .slice(0, 15)
                  .forEach(title => {

                    all.push({

                      category:
                        classify(title),

                      title,

                      description:
                        `Información publicada por ${source.name}.`,

                      link:
                        source.url

                    });

                  });

              } catch (error) {

                console.log(
                  "Fuente no disponible:",
                  source.name,
                  error.message
                );

              }

            }


            return [
              ...new Map(
                all.map(
                  item => [
                    item.title,
                    item
                  ]
                )
              ).values()
            ];

          }


          async function getDollar() {

            const result = {

              oficial: {
                venta: 0
              },

              blue: {
                venta: 0
              },

              actualizado:
                new Date().toLocaleString(
                  "es-AR",
                  {
                    timeZone:
                      "America/Argentina/La_Rioja"
                  }
                )

            };


            try {

              const response =
                await fetch(
                  "https://api.argentinadatos.com/v1/cotizaciones/dolares"
                );

              const data =
                await response.json();


              if (
                Array.isArray(data)
              ) {

                const oficial =
                  data.find(
                    x =>
                      x.casa ===
                      "oficial"
                  );


                const blue =
                  data.find(
                    x =>
                      x.casa ===
                      "blue"
                  );


                if (oficial) {

                  result.oficial.venta =
                    oficial.venta;

                }


                if (blue) {

                  result.blue.venta =
                    blue.venta;

                }

              }

            } catch (error) {

              console.log(
                "No se pudo actualizar dólar:",
                error.message
              );

            }


            return result;

          }


          async function getWeather() {

            const result = {

              temperatura: "--",

              descripcion:
                "Sin datos",

              icono:
                "🌤️"

            };


            try {

              /*
                Coordenadas aproximadas
                de La Rioja Capital.
              */

              const latitude =
                -29.4135;

              const longitude =
                -66.8568;


              const url =
                "https://api.open-meteo.com/v1/forecast" +
                "?latitude=" +
                latitude +
                "&longitude=" +
                longitude +
                "&current=temperature_2m,weather_code" +
                "&timezone=America%2FArgentina%2FLa_Rioja";


              const response =
                await fetch(url);


              const data =
                await response.json();


              if (
                data.current
              ) {

                result.temperatura =
                  data.current.temperature_2m;


                const code =
                  data.current.weather_code;


                if (
                  code === 0
                ) {

                  result.descripcion =
                    "Despejado";

                  result.icono =
                    "☀️";

                }

                else if (
                  code <= 3
                ) {

                  result.descripcion =
                    "Parcialmente nublado";

                  result.icono =
                    "🌤️";

                }

                else if (
                  code <= 48
                ) {

                  result.descripcion =
                    "Nublado";

                  result.icono =
                    "☁️";

                }

                else if (
                  code <= 67
                ) {

                  result.descripcion =
                    "Lluvia";

                  result.icono =
                    "🌧️";

                }

                else if (
                  code <= 82
                ) {

                  result.descripcion =
                    "Lluvias";

                  result.icono =
                    "🌦️";

                }

                else {

                  result.descripcion =
                    "Tormenta";

                  result.icono =
                    "⛈️";

                }

              }

            } catch (error) {

              console.log(
                "No se pudo actualizar clima:",
                error.message
              );

            }


            return result;

          }


          async function main() {

            const news =
              await getNews();


            const dolar =
              await getDollar();


            const clima =
              await getWeather();


            const rioja =
              news.filter(
                item =>
                  item.category ===
                  "La Rioja"
              );


            const policiales =
              news.filter(
                item =>
                  item.category ===
                  "Policiales"
              );


            const deportes =
              news.filter(
                item =>
                  item.category ===
                  "Deportes"
              );


            /*
              Si una categoría no tiene
              resultados, usamos noticias
              generales como respaldo.
            */

            const output = {

              actualizado:
                new Date().toISOString(),

              noticias:
                rioja.length
                ? rioja.slice(0, 8)
                : news.slice(0, 8),

              policiales:
                policiales.slice(0, 8),

              deportes:
                deportes.slice(0, 8),

              dolar,

              clima

            };


            fs.writeFileSync(
              "noticias.json",
              JSON.stringify(
                output,
                null,
                2
              )
            );


            console.log(
              "ARENA 24 actualizado correctamente."
            );

          }


          main();

          EOF


      - name: Ejecutar actualización
        run: node actualizar.js


      - name: Guardar datos
        run: |

          git config user.name "ARENA 24 BOT"

          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add noticias.json

          git diff --cached --quiet || \
          git commit -m "Actualización automática ARENA 24"

          git push
