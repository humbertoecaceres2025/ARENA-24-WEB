name: ARENA 24 - Actualizar noticias

on:
  workflow_dispatch:

  schedule:
    - cron: "*/30 * * * *"

permissions:
  contents: write

jobs:

  actualizar:

    runs-on: ubuntu-latest

    steps:

      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Instalar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.x"

      - name: Ejecutar actualizador
        run: |
          python actualizar_noticias.py

      - name: Guardar noticias
        run: |

          git config user.name "ARENA 24 Bot"

          git config user.email "actions@users.noreply.github.com"

          git add noticias.json

          if git diff --cached --quiet; then
            echo "No hay cambios para guardar."
          else
            git commit -m "ARENA 24 - actualización de noticias"
            git push
          fi
