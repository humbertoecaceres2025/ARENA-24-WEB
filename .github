      name: ARENA 24 - Actualizar noticias


on:

  schedule:

    # Cada 30 minutos
    - cron: "*/30 * * * *"

  workflow_dispatch:


permissions:

  contents: write


jobs:

  actualizar:

    runs-on: ubuntu-latest


    steps:

      - name: Descargar repositorio
        uses: actions/checkout@v4


      - name: Configurar Python
        uses: actions/setup-python@v5

        with:

          python-version: "3.x"


      - name: Actualizar noticias
        run: |

          python - <<'PY'

          import json
          import urllib.request
          import urllib.parse
          import xml.etree.ElementTree as ET
          from datetime import datetime, timezone


          # ==================================================
          # FUENTES RSS
          # ==================================================

          feeds = {

              "noticias": [
                  "https://www.lanacion.com.ar/arc/outboundfeeds/rss/",
                  "https://www.clarin.com/rss/",
                  "https://www.infobae.com/feeds/rss/"
              ],

              "policiales": [
                  "https://www.larioja.com.ar/rss",
                  "https://www.infobae.com/feeds/rss/"
              ],

              "deportes": [
                  "https://www.ole.com.ar/rss/",
                  "https://www.tycsports.com/rss/"
              ]

          }


          # ==================================================
          # DESCARGAR RSS
          # ==================================================

          def download(url):

              try:

                  req = urllib.request.Request(

                      url,

                      headers={
                          "User-Agent":
                          "Mozilla/5.0 ARENA24"
                      }

                  )

                  with urllib.request.urlopen(
                      req,
                      timeout=20
                  ) as response:

                      return response.read()

              except Exception as e:

                  print(
                      "Error RSS:",
                      url,
                      e
                  )

                  return None


          # ==================================================
          # PARSEAR RSS
          # ==================================================

          def parse_feed(xml_data):

              if not xml_data:
                  return []


              results = []


              try:

                  root = ET.fromstring(
                      xml_data
                  )


                  for item in root.findall(
                      ".//item"
                  ):

                      title = item.findtext(
                          "title"
                      )

                      link = item.findtext(
                          "link"
                      )

                      description = item.findtext(
                          "description"
                      )


                      if title:

                          results.append({

                              "titulo":
                              title.strip(),

                              "descripcion":
                              (description or "")
                              .strip()
                              [:300],

                              "url":
                              (link or "#")
                              .strip(),

                              "fuente":
                              "Fuente RSS"

                          })


              except Exception as e:

                  print(
                      "Error XML:",
                      e
                  )


              return results


          # ==================================================
          # OBTENER INFORMACIÓN
          # ==================================================

          final_data = {

              "actualizado":
              datetime.now(
                  timezone.utc
              ).strftime(
                  "%d/%m/%Y %H:%M UTC"
              ),

              "noticias": [],

              "policiales": [],

              "deportes": []

          }


          for category, urls in feeds.items():

              for feed_url in urls:

                  xml_data =
                  download(feed_url)


                  items =
                  parse_feed(xml_data)


                  for item in items:

                      if len(
                          final_data[category]
                      ) < 9:

                          final_data[
                              category
                          ].append(item)


                  if len(
                      final_data[category]
                  ) >= 9:

                      break


          # ==================================================
          # RESPALDO SI UNA FUENTE FALLA
          # ==================================================

          for category in final_data:

              if category == "actualizado":
                  continue


              if not final_data[category]:

                  final_data[category] = [

                      {

                          "titulo":
                          "Información en actualización",

                          "descripcion":
                          "El sistema de ARENA 24 volverá a intentar obtener información automáticamente.",

                          "fuente":
                          "ARENA 24",

                          "url":
                          "#"

                      }

                  ]


          # ==================================================
          # GUARDAR JSON
          # ==================================================

          with open(
              "noticias.json",
              "w",
              encoding="utf-8"
          ) as file:

              json.dump(
                  final_data,
                  file,
                  ensure_ascii=False,
                  indent=2
              )


          print(
              "noticias.json actualizado correctamente"
          )

          PY


      - name: Guardar cambios
        run: |

          git config user.name "ARENA 24 Bot"

          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add noticias.json

          git diff --cached --quiet || git commit -m "Actualizar noticias ARENA 24"

          git push
