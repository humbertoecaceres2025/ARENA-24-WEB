name: ARENA 24 - Actualizar noticias

on:

  schedule:
    - cron: "*/30 * * * *"

  workflow_dispatch:

permissions:
  contents: write


jobs:

  actualizar:

    runs-on: ubuntu-latest

    steps:

      - name: Descargar repositorio
        uses: actions/checkout@v4


      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.x"


      - name: Actualizar noticias
        run: |

          python - <<'PY'

          import json
          from datetime import datetime, timezone

          archivo = "noticias.json"

          try:

              with open(
                  archivo,
                  "r",
                  encoding="utf-8"
              ) as f:

                  datos = json.load(f)

          except Exception:

              datos = {
                  "noticias": []
              }


          datos["actualizado"] = (
              datetime.now(timezone.utc)
              .astimezone()
              .isoformat()
          )


          if not datos.get("noticias"):

              datos["noticias"] = [

                  {
                      "categoria": "La Rioja",
                      "titulo": "ARENA 24 Noticias",
                      "descripcion": "Información de La Rioja."
                  },

                  {
                      "categoria": "Argentina",
                      "titulo": "Actualidad nacional",
                      "descripcion": "Noticias de Argentina."
                  },

                  {
                      "categoria": "Mundo",
                      "titulo": "Actualidad internacional",
                      "descripcion": "Las principales noticias del mundo."
                  },

                  {
                      "categoria": "Deportes",
                      "titulo": "ARENA 24 Deportes",
                      "descripcion": "Toda la actualidad deportiva."
                  },

                  {
                      "categoria": "Policiales",
                      "titulo": "Policiales",
                      "descripcion": "Información policial."
                  }

              ]


          with open(
              archivo,
              "w",
              encoding="utf-8"
          ) as f:

              json.dump(
                  datos,
                  f,
                  ensure_ascii=False,
                  indent=2
              )

          PY


      - name: Guardar actualización
        run: |

          git config user.name "ARENA 24 Bot"

          git config user.email "actions@users.noreply.github.com"

          git add noticias.json

          git diff --cached --quiet || \
          git commit -m "Actualizar noticias ARENA 24"

          git push
