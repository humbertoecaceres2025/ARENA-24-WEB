name: Actualizar noticias

on:
  schedule:
    - cron: "*/30 * * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  actualizar:
    runs-on: ubuntu-latest

    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Actualizar noticias
        run: node scripts/actualizar-noticias.js

      - name: Guardar cambios
        run: |
          git config user.name "ARENA 24 Bot"
          git config user.email "actions@github.com"

          git add noticias.json

          if git diff --cached --quiet; then
            echo "No hay noticias nuevas"
          else
            git commit -m "Actualizar noticias automáticamente"
            git push
          fi
