name: ARENA 24 - Actualizar noticias

on:
  schedule:
    - cron: "*/30 * * * *"

  workflow_dispatch:

permissions:
  contents: write

jobs:

  actualizar-noticias:

    runs-on: ubuntu-latest

    steps:

      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.x"

      - name: Instalar dependencias
        run: |
          python -m pip install --upgrade pip
          pip install feedparser requests beautifulsoup4

      - name: Obtener noticias RSS directas
        run: |

          python <<'PY'

          import json
          import os
          import re
          from datetime import datetime, timezone

          import feedparser
          import requests
          from bs4 import BeautifulSoup


          OUTPUT = "noticias.json"

          MAX_TOTAL = 50

          TIMEOUT = 20


          # ==================================================
          # FUENTES DIRECTAS
          #
          # NO SE UTILIZA GOOGLE NEWS
          # ==================================================

          FEEDS = [

              # ==============================================
              # LA RIOJA
              # ==============================================

              {
                  "name": "El Independiente",
                  "url": "https://www.elindependiente.com.ar/",
                  "category": "LA RIOJA",
                  "type": "website"
              },

              {
                  "name": "Nueva Rioja",
                  "url": "https://www.nuevarioja.com.ar/",
                  "category": "LA RIOJA",
                  "type": "website"
              },


              # ==============================================
              # NACIONALES
              # ==============================================

              {
                  "name": "Clarín",
                  "url": "https://www.clarin.com/rss/lo-ultimo/",
                  "category": "NACIONALES",
                  "type": "rss"
              },

              {
                  "name": "LA NACION",
                  "url": "https://www.lanacion.com.ar/arc/outboundfeeds/rss/?outputType=xml",
                  "category": "NACIONALES",
                  "type": "rss"
              },

              {
                  "name": "Infobae",
                  "url": "https://www.infobae.com/arc/outboundfeeds/rss/",
                  "category": "NACIONALES",
                  "type": "rss"
              }

          ]


          HEADERS = {
              "User-Agent":
                  "Mozilla/5.0 ARENA24 News Reader"
          }


          def clean_text(value):

              if not value:
                  return ""

              soup = BeautifulSoup(
                  str(value),
                  "html.parser"
              )

              text = soup.get_text(
                  " ",
                  strip=True
              )

              text = re.sub(
                  r"\s+",
                  " ",
                  text
              )

              return text.strip()


          def get_image(entry):

              media = entry.get(
                  "media_content",
                  []
              )

              for item in media:

                  if item.get("url"):
                      return item["url"]


              media = entry.get(
                  "media_thumbnail",
                  []
              )

              for item in media:

                  if item.get("url"):
                      return item["url"]


              html = (
                  entry.get("summary")
                  or entry.get("description")
                  or ""
              )

              match = re.search(
                  r'<img[^>]+src=["\']([^"\']+)["\']',
                  html,
                  re.I
              )

              if match:
                  return match.group(1)


              return ""


          def get_date(entry):

              value = (
                  entry.get("published")
                  or entry.get("updated")
                  or ""
              )

              if value:
                  try:

                      parsed = entry.get(
                          "published_parsed"
                      ) or entry.get(
                          "updated_parsed"
                      )

                      if parsed:

                          from email.utils import format_datetime
                          from datetime import datetime

                          dt = datetime(
                              parsed.tm_year,
                              parsed.tm_mon,
                              parsed.tm_mday,
                              parsed.tm_hour,
                              parsed.tm_min,
                              parsed.tm_sec,
                              tzinfo=timezone.utc
                          )

                          return dt.isoformat()

                  except Exception:
                      pass

              return datetime.now(
                  timezone.utc
              ).isoformat()


          def read_rss(feed):

              print(
                  "RSS:",
                  feed["name"]
              )

              response = requests.get(
                  feed["url"],
                  headers=HEADERS,
                  timeout=TIMEOUT
              )

              response.raise_for_status()

              parsed = feedparser.parse(
                  response.content
              )

              results = []

              for entry in parsed.entries[:20]:

                  title = clean_text(
                      entry.get("title")
                  )

                  link = (
                      entry.get("link")
                      or ""
                  ).strip()

                  if not title or not link:
                      continue

                  description = clean_text(
                      entry.get(
                          "summary",
                          ""
                      )
                  )

                  results.append({

                      "title": title,

                      "description":
                          description,

                      "image":
                          get_image(entry),

                      "link":
                          link,

                      "category":
                          feed["category"],

                      "source":
                          feed["name"],

                      "date":
                          get_date(entry)

                  })

              return results


          def read_website(feed):

              print(
                  "Sitio local:",
                  feed["name"]
              )

              response = requests.get(
                  feed["url"],
                  headers=HEADERS,
                  timeout=TIMEOUT
              )

              response.raise_for_status()

              soup = BeautifulSoup(
                  response.text,
                  "html.parser"
              )

              results = []

              seen = set()

              for article in soup.select(
                  "article"
              ):

                  heading = article.select_one(
                      "h1,h2,h3,h4"
                  )

                  anchor = article.select_one(
                      "a[href]"
                  )

                  if not heading or not anchor:
                      continue

                  title = clean_text(
                      heading.get_text()
                  )

                  link = anchor.get(
                      "href",
                      ""
                  )

                  if not link:
                      continue

                  if link.startswith("/"):
                      link = (
                          feed["url"].rstrip("/")
                          + link
                      )

                  if title.lower() in seen:
                      continue

                  seen.add(
                      title.lower()
                  )

                  results.append({

                      "title":
                          title,

                      "description":
                          "",

                      "image":
                          "",

                      "link":
                          link,

                      "category":
                          feed["category"],

                      "source":
                          feed["name"],

                      "date":
                          datetime.now(
                              timezone.utc
                          ).isoformat()

                  })

                  if len(results) >= 15:
                      break

              return results


          all_news = []


          # ==================================================
          # PROCESAR FUENTES
          # ==================================================

          for feed in FEEDS:

              try:

                  if feed["type"] == "rss":

                      items = read_rss(
                          feed
                      )

                  else:

                      items = read_website(
                          feed
                      )

                  all_news.extend(
                      items
                  )

                  print(
                      feed["name"],
                      "=>",
                      len(items),
                      "noticias"
                  )

              except Exception as error:

                  print(
                      "ERROR:",
                      feed["name"],
                      error
                  )


          # ==================================================
          # ELIMINAR DUPLICADOS
          # ==================================================

          unique = {}

          for item in all_news:

              key = (
                  item["link"]
                  or item["title"]
              ).strip().lower()

              if key not in unique:

                  unique[key] = item


          news = list(
              unique.values()
          )


          # ==================================================
          # ORDENAR
          # ==================================================

          news.sort(
              key=lambda x:
                  x.get("date", ""),
              reverse=True
          )


          news = news[:MAX_TOTAL]


          # ==================================================
          # RESPALDO
          # ==================================================

          if not news:

              print(
                  "No hubo noticias nuevas."
              )

              if os.path.exists(
                  OUTPUT
              ):

                  print(
                      "Se conserva el JSON anterior."
                  )

                  raise SystemExit(0)


          # ==================================================
          # GUARDAR
          # ==================================================

          data = {

              "updated":
                  datetime.now(
                      timezone.utc
                  ).isoformat(),

              "source":
                  "ARENA 24",

              "noticias":
                  news

          }


          with open(
              OUTPUT,
              "w",
              encoding="utf-8"
          ) as file:

              json.dump(
                  data,
                  file,
                  ensure_ascii=False,
                  indent=2
              )


          print(
              "TOTAL:",
              len(news)
          )

          print(
              "JSON generado correctamente."
          )

          PY


      - name: Validar noticias.json
        run: |

          python <<'PY'

          import json

          with open(
              "noticias.json",
              encoding="utf-8"
          ) as f:

              data = json.load(f)

          assert isinstance(
              data,
              dict
          )

          assert isinstance(
              data.get("noticias"),
              list
          )

          print(
              "JSON OK:",
              len(data["noticias"]),
              "noticias"
          )

          PY


      - name: Guardar cambios
        run: |

          git config user.name \
            "ARENA 24 Bot"

          git config user.email \
            "actions@github.com"

          git add noticias.json

          if git diff --cached --quiet; then

            echo "Sin cambios."

          else

            git commit \
              -m "ARENA 24: actualizar noticias"

            git push

          fi
