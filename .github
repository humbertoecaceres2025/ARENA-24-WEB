name: ARENA 24 - Actualizar noticias

on:
schedule:
# Ejecuta la actualización cada 30 minutos
- cron: "*/30 * * * *"

Permite ejecutarlo manualmente desde GitHub

workflow_dispatch:

permissions:
contents: write

jobs:
actualizar:
runs-on: ubuntu-latest

steps:

  - name: Descargar repositorio
    uses: actions/checkout@v4

  - name: Configurar Python
    uses: actions/setup-python@v5
    with:
      python-version: "3.x"

  - name: Descargar noticias
    run: |
      python - <<'PY'
      import json
      import urllib.request
      from datetime import datetime, timezone

      # Fuentes RSS públicas
      fuentes = [
          (
              "ARGENTINA",
              "https://www.lanacion.com.ar/arc/outboundfeeds/rss/"
          ),
          (
              "MUNDO",
              "https://feeds.bbci.co.uk/mundo/rss.xml"
          )
      ]

      noticias = []

      for categoria, url in fuentes:
          try:
              req = urllib.request.Request(
                  url,
                  headers={
                      "User-Agent": "Mozilla/5.0 ARENA24-NewsBot"
                  }
              )

              with urllib.request.urlopen(req, timeout=20) as respuesta:
                  contenido = respuesta.read().decode("utf-8", errors="ignore")

              import xml.etree.ElementTree as ET

              raiz = ET.fromstring(contenido)

              for item in raiz.findall(".//item")[:5]:

                  titulo = item.findtext("title", "").strip()
                  descripcion = item.findtext("description", "").strip()
                  enlace = item.findtext("link", "").strip()

                  if titulo:
                      noticias.append({
                          "categoria": categoria,
                          "titulo": titulo,
                          "resumen": descripcion,
                          "url": enlace
                      })

          except Exception as error:
              print(f"Error en {categoria}: {error}")

      datos = {
          "actualizado": datetime.now(
              timezone.utc
          ).isoformat(),

          "noticias": noticias
      }

      with open("noticias.json", "w", encoding="utf-8") as archivo:
          json.dump(
              datos,
              archivo,
              ensure_ascii=False,
              indent=2
          )

      print(f"Noticias guardadas: {len(noticias)}")
      PY

  - name: Guardar noticias actualizadas
    run: |
      git config user.name "ARENA 24 Bot"
      git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

      git add noticias.json

      if git diff --cached --quiet; then
        echo "No hay cambios para guardar."
      else
        git commit -m "Actualización automática de noticias"
        git push
      fi
