const fs = require('fs');

// 1. Leer el archivo JSON actual
const archivoRuta = './noticias.json';
const jsonData = fs.readFileSync(archivoRuta, 'utf-8');
const noticias = JSON.parse(jsonData);

// 2. Crear el objeto de la nueva noticia
const nuevaNoticia = {
  id: noticias.length + 1,
  titulo: "Título de la nueva noticia",
  fecha: "2026-09-20",
  contenido: "Este es el texto completo de la noticia.",
  autor: "Redacción"
};

// 3. Agregar la noticia al array existente
noticias.push(nuevaNoticia);

// 4. Guardar el resultado actualizado en el archivo JSON
fs.writeFileSync(archivoRuta, JSON.stringify(noticias, null, 2), 'utf-8');

console.log("¡Noticia agregada con éxito!");
