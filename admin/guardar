<?php

require_once 'config.php';

verificarSesion();

$titulo = trim($_POST['titulo'] ?? '');
$resumen = trim($_POST['resumen'] ?? '');
$contenido = trim($_POST['contenido'] ?? '');
$categoria = trim($_POST['categoria'] ?? 'La Rioja');
$autor = trim($_POST['autor'] ?? 'Redacción Arena 24');
$estado = trim($_POST['estado'] ?? 'publicado');
$meta = trim($_POST['meta_description'] ?? '');
$slug = trim($_POST['slug'] ?? '');

if ($titulo === '' || $resumen === '' || $contenido === '') {
    die('Faltan campos obligatorios.');
}


/*
|--------------------------------------------------------------------------
| SLUG
|--------------------------------------------------------------------------
*/

function crearSlug($texto)
{
    $texto = strtolower($texto);

    $texto = iconv(
        'UTF-8',
        'ASCII//TRANSLIT//IGNORE',
        $texto
    );

    $texto = preg_replace(
        '/[^a-z0-9]+/',
        '-',
        $texto
    );

    return trim($texto, '-');
}

if ($slug === '') {
    $slug = crearSlug($titulo);
}

$slug = crearSlug($slug);


/*
|--------------------------------------------------------------------------
| IMAGEN
|--------------------------------------------------------------------------
*/

$imagen = '';

if (
    isset($_FILES['imagen']) &&
    $_FILES['imagen']['error'] === UPLOAD_ERR_OK
) {

    if (!is_dir(CARPETA_IMAGENES)) {
        mkdir(CARPETA_IMAGENES, 0755, true);
    }

    $tmp = $_FILES['imagen']['tmp_name'];

    $info = getimagesize($tmp);

    if (!$info) {
        die('La imagen no es válida.');
    }

    $permitidos = [
        'image/jpeg' => 'jpg',
        'image/png' => 'png',
        'image/webp' => 'webp'
    ];

    if (!isset($permitidos[$info['mime']])) {
        die('Formato de imagen no permitido.');
    }

    $extension =
        $permitidos[$info['mime']];

    $nombre =
        'arena24-' .
        time() .
        '-' .
        bin2hex(random_bytes(4)) .
        '.' .
        $extension;

    $destino =
        CARPETA_IMAGENES .
        $nombre;

    if (!move_uploaded_file($tmp, $destino)) {
        die('No se pudo guardar la imagen.');
    }

    $imagen =
        'uploads/' . $nombre;
}


/*
|--------------------------------------------------------------------------
| NOTICIAS
|--------------------------------------------------------------------------
*/

$noticias = [];

if (file_exists(ARCHIVO_NOTICIAS)) {

    $noticias =
        json_decode(
            file_get_contents(ARCHIVO_NOTICIAS),
            true
        );

    if (!is_array($noticias)) {
        $noticias = [];
    }
}

$ids =
    array_column($noticias, 'id');

$id =
    $ids ? max($ids) + 1 : 1;

$fechaISO =
    date('c');

$fecha =
    date('d/m/Y · H:i');


$nueva = [

    'id' => $id,

    'titulo' => $titulo,

    'resumen' => $resumen,

    'contenido' => $contenido,

    'categoria' => $categoria,

    'autor' => $autor,

    'estado' => $estado,

    'fecha' => $fecha,

    'fecha_iso' => $fechaISO,

    'imagen' => $imagen,

    'slug' => $slug,

    'meta_description' =>
        $meta !== ''
        ? $meta
        : $resumen,

    'url' =>
        'noticia.php?slug=' .
        urlencode($slug)

];


array_unshift(
    $noticias,
    $nueva
);


file_put_contents(
    ARCHIVO_NOTICIAS,
    json_encode(
        $noticias,
        JSON_PRETTY_PRINT |
        JSON_UNESCAPED_UNICODE |
        JSON_UNESCAPED_SLASHES
    ),
    LOCK_EX
);


header('Location: index.php');

exit;
